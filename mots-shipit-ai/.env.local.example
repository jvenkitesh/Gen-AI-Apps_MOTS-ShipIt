# MOTS ShipIt — environment variables
# Values must be empty here (.env.example). Copy to .env.local and fill in real values.

# Supabase (new project — not shared with the sibling ContractIQ project)
NEXT_PUBLIC_SUPABASE_URL=              # Project URL — Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_ANON_KEY=         # anon/public key — Project Settings > API
SUPABASE_SERVICE_ROLE_KEY=             # service role key — Project Settings > API # SERVER ONLY, never expose to client

# OpenAI (load-estimate answer wording; same account as the ContractIQ project)
OPENAI_API_KEY=                        # platform.openai.com > API keys # SERVER ONLY
OPENAI_MODEL=                          # optional, defaults to gpt-4o-mini

# ShipStation (KB2 — free tier; rate ESTIMATES only, ShipIt never books or buys labels)
SHIPSTATION_API_KEY=                   # app.shipstation.com > API Settings # SERVER ONLY. A TEST_ key uses the sandbox (UPS, FedEx, USPS only, no cost)
SHIPSTATION_FROM_POSTAL_CODE=          # zip of the origin hub (Memphis, TN routing guide), e.g. 38103
SHIPSTATION_CARRIER_IDS=               # optional, comma-separated carrier ids (se-123,se-456); empty = all carriers connected to the account

# Carrier outreach (Feature 5). Test mode is the default and never contacts real carriers.
OUTREACH_MODE=                         # "test" (default) or "live" -- set live only after legal (TCPA) sign-off
OUTREACH_TEST_EMAIL=                   # test mode: messages go here (if Resend is set up); otherwise they are simulated
OUTREACH_TEST_PHONE=                   # test mode: SMS go here (if Twilio is set up and no test email)
OUTREACH_MAX_MESSAGES_PER_CONTACT_PER_DAY= # optional, defaults to 3
OUTREACH_BATCH_WAIT_MINUTES=           # optional, minutes between batches for one load, defaults to 30
RESEND_API_KEY=                        # resend.com > API Keys # SERVER ONLY -- email provider
OUTREACH_FROM_EMAIL=                   # verified sender, e.g. "MOTS ShipIt <loads@yourdomain.com>"
TWILIO_ACCOUNT_SID=                    # twilio.com console # SERVER ONLY -- SMS provider
TWILIO_AUTH_TOKEN=                     # SERVER ONLY
TWILIO_FROM_NUMBER=                    # Twilio phone number, E.164 format (+1...)

# Negotiation and compliance (Feature 6)
OFFER_MIN_CONFIDENCE=                  # optional, 0-1, below this a person reviews the offer; defaults to 0.8
COMPLIANCE_FRESHNESS_HOURS=            # optional, a compliance check older than this blocks approval; defaults to 24
FMCSA_WEB_KEY=                         # optional, FMCSA QCMobile API web key for automatic carrier checks # SERVER ONLY

# Load estimate
ESTIMATE_DEFAULT_WEIGHT_POUNDS=        # optional, weight used when the question has none; defaults to 10

# TMS webhook (generic adapter — rotate this secret per TMS integration once a real TMS is chosen)
TMS_WEBHOOK_SECRET=                    # shared secret: checked on POST /api/loads/webhook and used to sign booking write-backs # SERVER ONLY
TMS_BOOKING_WEBHOOK_URL=               # where bookings are written back to the TMS (signed JSON POST); empty = sync stays "failed" until set

# App
NEXT_PUBLIC_APP_URL=                   # http://localhost:3000 in dev; the Netlify URL in production

# Security (Stage 7)
# MAX_CHAT_HISTORY is not used: ShipIt sends no conversation history to the model (one question or
# one carrier reply per call). Limits live in lib/security/tokenLimiter.ts.

# Note: KB1 (routing guide) is the Supabase table transportation_shipment.routing_guide — no env var needed.
# Note: KB3 (Unisco Freight Glossary, unisco.com/freight-glossary) is fetched live from a public URL — no API key needed.
